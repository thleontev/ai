{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "electronics-parts": {
      "type": "local",
      "command": [
        "C:\\Program Files\\nodejs\\node.exe",
        "C:\\PATH\\TO\\electronics-parts\\server.mjs"
      ],
      "enabled": true
    },
    "sqlite-memory": {
      "type": "local",
      "command": [
        "C:\\Program Files\\nodejs\\node.exe",
        "C:\\PATH\\TO\\electronics-parts\\mcp\\sqlite-memory\\server.mjs"
      ],
      "cwd": "C:\\PATH\\TO\\electronics-parts\\mcp\\sqlite-memory",
      "environment": {
        "ELECTRONICS_PARTS_DB": "C:\\PATH\\TO\\electronics-parts\\data\\electronics-parts.db",
        "ELECTRONICS_PARTS_SCHEMA": "C:\\PATH\\TO\\electronics-parts\\db\\schema.sql"
      },
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  }
}
