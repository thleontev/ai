# Copy the needed values to your user environment or a local .env file.
# Never commit populated credentials or browser cookies.

# DigiKey Product Information API
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_USE_SANDBOX=false
DIGIKEY_SITE=US
DIGIKEY_CURRENCY=USD
DIGIKEY_LANGUAGE=en

# Mouser Search API
MOUSER_API_KEY=

# LCSC B2B API (requires approval and an allowlisted outbound IP address)
LCSC_API_KEY=
LCSC_API_SECRET=
LCSC_SIGNATURE_ALGORITHM=sha256

# JLCPCB Components API
JLCPCB_APP_ID=
JLCPCB_ACCESS_KEY=
JLCPCB_SECRET_KEY=

# Optional: your own Elitan browser session; never share it
ELITAN_COOKIE=

# Optional request timeout in milliseconds
COMPONENT_SOURCING_TIMEOUT_MS=30000

# SQLite MCP paths are normally configured in OpenCode, not stored here.
ELECTRONICS_PARTS_DB=
ELECTRONICS_PARTS_SCHEMA=
